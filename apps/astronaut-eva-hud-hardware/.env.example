# Phase 1 uses local simulated telemetry and requires no API keys.
# Future provider connection settings belong at the service boundary.

# Live ESP32 + MAX30102 sensor (hardware/esp32_crewhealth). Default shown; ?sensor=ws://… overrides per page.
# VITE_SENSOR_WS_URL=ws://crewhealth-ev1.local:81/
# VITE_SENSOR_LINK=off   # uncomment to run the HUD on its own readings
